# Copy to .dev.vars for local testing with `npx wrangler pages dev dist`
# (on Cloudflare, set these in Pages → Settings → Variables and Secrets)
#
# Google Apps Script web app URL (Deploy → Web app → .../exec)
CONTACT_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# Shared secret — must match the token in your Apps Script
CONTACT_SECRET=replace-with-a-long-random-string
